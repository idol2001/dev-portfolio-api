# ============================================================
# 数据库配置（必填）
# ============================================================
# 数据库类型: sqlite (默认) | mysql
DB_TYPE=sqlite

# --- SQLite 配置 ---
SQLITE_FILE=data/portfolio.db

# --- MySQL 配置 (仅当 DB_TYPE=mysql 时需要) ---
# MYSQL_USERNAME=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_HOST=
# MYSQL_PORT=3306

# ============================================================
# Casdoor 配置（可选，如不使用 CAS 认证可留空）
# ============================================================
CASDOOR_ENDPOINT=http://127.0.0.1:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=

# ============================================================
# 阿里云 OSS 配置（未启用时留空即可）
# ============================================================
ALIYUNOSS_ENABLE=false
ALIYUNOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUNOSS_ACCESS_KEY_ID=
ALIYUNOSS_ACCESS_KEY_SECRET=
ALIYUNOSS_BUCKET_NAME=
ALIYUNOSS_BUCKET_DOMAIN=
ALIYUNOSS_DIR_PREFIX=dev-portfolio
